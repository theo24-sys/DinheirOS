# ==============================================================
# DinheirOS Cloud Configuration (Vercel + Supabase)
# ==============================================================

# Server
PORT=3000
NODE_ENV=development

# --------------------------------------------------------------
# 1. SUPABASE (Required)
# From Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-or-secret-api-key"

# WebAuthn passkeys: update both values if you use a custom app domain.
WEBAUTHN_RP_ID="dinheir-os.vercel.app"
WEBAUTHN_ORIGIN="https://dinheir-os.vercel.app"

# New users receive a random per-user PIN salt; no PIN_SALT is required.
# Existing deployments may keep their old PIN_SALT temporarily until each user
# signs in once and their PIN is migrated to a per-user salt.
CRON_SECRET="optional_secret_for_cron_endpoint"

# --------------------------------------------------------------
# 3. SAFARICOM DARAJA B2C (Optional - Runs in MOCK mode if blank)
# --------------------------------------------------------------
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_INITIATOR_NAME=""
DARAJA_SECURITY_CREDENTIAL=""
MPESA_ENVIRONMENT="production"
CALLBACK_URL="https://dinheir-os.vercel.app/api/daraja/callback"
