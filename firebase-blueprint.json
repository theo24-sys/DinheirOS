{
  "entities": {
    "wallet": {
      "title": "Wallet",
      "description": "Represents a controlled spending category.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "allocation": { "type": "number" },
        "maxFrequency": { "type": "number" },
        "usedFrequency": { "type": "number" },
        "rolloverBonus": { "type": "number" },
        "perWithdrawalAmount": { "type": "number" },
        "lastWithdrawalDate": { "type": "string", "format": "date-time" },
        "locked": { "type": "boolean" },
        "dailyLimit": { "type": "number", "description": "Max withdrawals per day." }
      },
      "required": ["id", "name", "allocation", "maxFrequency", "usedFrequency", "perWithdrawalAmount", "locked"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "A record of a withdrawal request and its outcome.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "walletId": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"] },
        "darajaConversationId": { "type": "string" },
        "reason": { "type": "string", "description": "Reason for denial or failure." }
      },
      "required": ["id", "walletId", "amount", "timestamp", "status"]
    }
  },
  "firestore": {
    "/wallets": {
      "schema": "wallet",
      "description": "Active controlled wallets."
    },
    "/transactions": {
      "schema": "transaction",
      "description": "Ledger of all withdrawal requests."
    }
  }
}
